namespace Am.Json {

    enum JsonValueType {
        stringType = 1
        intType = 2
        longType = 3
        boolType = 4
        nullType = 5
        objectType = 6
        arrayType = 7
    }

    class JsonValue(private var value: Any?, private var type: JsonValueType) {
        import Am.Lang

        public fun getValue(): Any? {
            return this.value
        }

        public fun getType(): JsonValueType {
            return this.type
        }

        public fun isString(): Bool {
            return this.type == JsonValueType.stringType
        }

        public fun isInteger(): Bool {
            return this.type == JsonValueType.intType
        }

        public fun isLong(): Bool {
            return this.type == JsonValueType.longType
        }

        public fun isBool(): Bool {
            return this.type == JsonValueType.boolType
        }

        public fun isNull(): Bool {
            return this.type == JsonValueType.nullType
        }

        public fun isObject(): Bool {
            return this.type == JsonValueType.objectType
        }

        public fun isArray(): Bool {
            return this.type == JsonValueType.arrayType
        }

        public fun isDouble(): Bool {
            // This JSON library doesn't support double type, only string-based values
            return false
        }

        public fun asString(): String {
            if (this.type == JsonValueType.stringType) {
                return this.value as String
            } else {
                throw new Exception("JsonValue is not a string")
            }
        }

        public fun asInteger(): Int {
            if (this.type == JsonValueType.intType) {
                return this.value as Int
            } else {
                throw new Exception("JsonValue is not an integer")
            }
        }

        public fun asLong(): Long {
            if (this.type == JsonValueType.longType) {
                return this.value as Long
            } else {
                throw new Exception("JsonValue is not a long")
            }
        }

        public fun asBool(): Bool {
            if (this.type == JsonValueType.boolType) {
                return this.value as Bool
            } else {
                throw new Exception("JsonValue is not a boolean")
            }
        }

        public fun asObject(): JsonObject {
            if (this.type == JsonValueType.objectType) {
                return this.value as JsonObject
            } else {
                throw new Exception("JsonValue is not an object")
            }
        }

        public fun asArray(): JsonArray {
            if (this.type == JsonValueType.arrayType) {
                return this.value as JsonArray
            } else {
                throw new Exception("JsonValue is not an array")
            }
        }

        static fun fromString(value: String): JsonValue {
            return new JsonValue(value, JsonValueType.stringType)
        }

        static fun fromInteger(value: Int): JsonValue {
            return new JsonValue(value, JsonValueType.intType)
        }

        static fun fromLong(value: Long): JsonValue {
            return new JsonValue(value, JsonValueType.longType)
        }

        static fun fromBool(value: Bool): JsonValue {
            return new JsonValue(value, JsonValueType.boolType)
        }

        static fun fromObject(value: JsonObject): JsonValue {
            return new JsonValue(value, JsonValueType.objectType)
        }

        static fun fromArray(value: JsonArray): JsonValue {
            return new JsonValue(value, JsonValueType.arrayType)
        }

        static fun fromNull(): JsonValue {
            var nullValue: Any? = null
            return new JsonValue(nullValue, JsonValueType.nullType)
        }

        override fun toString(): String {
            if (this.type == JsonValueType.stringType) {
                return this.asString()
            } else if (this.type == JsonValueType.intType) {
                return this.asInteger().toString()
            } else if (this.type == JsonValueType.longType) {
                return this.asLong().toString()
            } else if (this.type == JsonValueType.boolType) {
                if (this.asBool()) {
                    return "true"
                } else {
                    return "false"
                }
            } else if (this.type == JsonValueType.nullType) {
                return "null"
            } else if (this.type == JsonValueType.objectType) {
                return this.asObject().toString()
            } else if (this.type == JsonValueType.arrayType) {
                return this.asArray().toString()
            } else {
                return "unknown"
            }
        }
    }
}
