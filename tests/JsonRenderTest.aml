namespace Tests {

    class JsonRenderTest {
        import Am.Lang
        import Am.Json
        import Am.Tests

        test testSimpleStringRendering() {
            var value: JsonValue = JsonValue.fromString("hello")
            var json: String = value.toJsonString()
            Assert.assertTrue(json == "\"hello\"")
        }

        test testNumberRendering() {
            var value: JsonValue = JsonValue.fromInteger(42)
            var json: String = value.toJsonString()
            Assert.assertTrue(json == "42")
        }

        test testBoolRendering() {
            var trueValue: JsonValue = JsonValue.fromBool(true)
            var falseValue: JsonValue = JsonValue.fromBool(false)
            Assert.assertTrue(trueValue.toJsonString() == "true")
            Assert.assertTrue(falseValue.toJsonString() == "false")
        }

        test testNullRendering() {
            var value: JsonValue = JsonValue.fromNull()
            var json: String = value.toJsonString()
            Assert.assertTrue(json == "null")
        }

        test testEmptyObjectAndArray() {
            var emptyObj: JsonObject = new JsonObject()
            var emptyArr: JsonArray = new JsonArray()
            
            Assert.assertTrue(emptyObj.toJsonString() == "{}")
            Assert.assertTrue(emptyArr.toJsonString() == "[]")
        }

        test testComplexObjectRendering() {
            // Create a complex nested object structure
            var mainObj = new JsonObject()
            
            // Add simple values using the correct put methods
            mainObj.putString("name", "John Doe")
            mainObj.putInt("age", 30)
            mainObj.putBool("isActive", true)
            mainObj.putNull("salary")
            
            // Create nested object
            var address = new JsonObject()
            address.putString("street", "123 Main St")
            address.putString("city", "New York")
            address.putInt("zipCode", 10001)
            mainObj.putObject("address", address)
            
            // Create array of strings
            var hobbies = new JsonArray()
            hobbies.addString("reading")
            hobbies.addString("swimming")
            hobbies.addString("coding")
            mainObj.putArray("hobbies", hobbies)
            
            // Create array of objects
            var contacts = new JsonArray()
            var contact1 = new JsonObject()
            contact1.putString("type", "email")
            contact1.putString("value", "john@example.com")
            contacts.addObject(contact1)
            
            var contact2 = new JsonObject()
            contact2.putString("type", "phone")
            contact2.putString("value", "555-1234")
            contacts.addObject(contact2)
            mainObj.putArray("contacts", contacts)
            
            // Render to JSON string
            var jsonString = mainObj.toJsonString()
            
            // Print for visual inspection
            "Complex JSON output:".println()
            jsonString.println()
            
            // Basic validation - check that it contains expected elements
            Assert.assertTrue(jsonString.getLength() > 50) // Should be a substantial string
            
            "Complex object rendering test passed!".println()
        }
    }
    }
}