namespace Am.Json.Tests {
    class JsonParserTest {
        import Am.Lang
        import Am.Json
        import Am.Tests
        import Am.Util.Parsers.Text

        test parseSimpleJsonObject() {
            // Build JSON string using proper character conversion
            var quoteBytes: UByte[] = [34UB]
            var quote: String = String.fromBytes(quoteBytes, "UTF-8")
            var jsonStr: String = "{" + quote + "name" + quote + ":" + quote + "John" + quote + "}"
            var textParser: TextParser = new TextParser(jsonStr)
            var jsonParser: JsonParser = new JsonParser(textParser)
            var jsonRoot = jsonParser.parse()
            var result = jsonRoot.asObject()
            var name: String = result.getString("name")
            Assert.assertTrue(name == "John")
        }

        test parseSimpleJsonArray() {
            // Build JSON string using proper character conversion
            var quoteBytes: UByte[] = [34UB]
            var quote: String = String.fromBytes(quoteBytes, "UTF-8")
            var jsonStr: String = "[" + quote + "apple" + quote + "," + quote + "banana" + quote + "," + quote + "cherry" + quote + "," + quote + "date" + quote + "]"
            var textParser: TextParser = new TextParser(jsonStr)
            var jsonParser: JsonParser = new JsonParser(textParser)
            var jsonRoot = jsonParser.parse()
            var result = jsonRoot.asArray()

            var item0: String = result.getString(0)
            var item1: String = result.getString(1)
            var item2: String = result.getString(2)
            var item3: String = result.getString(3)
            Assert.assertTrue(item0 == "apple")
            Assert.assertTrue(item1 == "banana")
            Assert.assertTrue(item2 == "cherry")
            Assert.assertTrue(item3 == "date")
        }

        test parseNestedStringJson() {
            // Build JSON string using proper character conversion
            var quoteBytes: UByte[] = [34UB]
            var quote: String = String.fromBytes(quoteBytes, "UTF-8")
            var jsonStr: String = "{" + quote + "users" + quote + ":[" + quote + "Alice" + quote + "," + quote + "Bob" + quote + "]," + quote + "count" + quote + ":" + quote + "2" + quote + "}"
            var textParser: TextParser = new TextParser(jsonStr)
            var jsonParser: JsonParser = new JsonParser(textParser)
            var jsonRoot = jsonParser.parse()
            var result = jsonRoot.asObject()

            var users: JsonArray = result.getJsonArray("users")
            var usersSize: Int = users.size()
            Assert.assertTrue(usersSize == 2)
            var firstUser: String = users.getString(0)
            var secondUser: String = users.getString(1)
            var count: String = result.getString("count")
            Assert.assertTrue(firstUser == "Alice")
            Assert.assertTrue(secondUser == "Bob")
            Assert.assertTrue(count == "2")
        }
    }
}