namespace Am.Json {

    class JsonArray {
        import Am.Lang
        import Am.Collections
        private var elements: List<JsonValue> = List.newList<JsonValue>()

        // Add methods for different types
        public fun addString(value: String): Void {
            this.elements.add(JsonValue.fromString(value))
        }

        public fun addInt(value: Int): Void {
            this.elements.add(JsonValue.fromInteger(value))
        }

        public fun addLong(value: Long): Void {
            this.elements.add(JsonValue.fromLong(value))
        }

        /*
        public fun addDouble(value: Double): Void {
            this.elements.add(JsonValue.fromDouble(value))
        }
            */

        public fun addBool(value: Bool): Void {
            this.elements.add(JsonValue.fromBool(value))
        }

        public fun addObject(value: JsonObject): Void {
            this.elements.add(JsonValue.fromObject(value))
        }

        public fun addArray(value: JsonArray): Void {
            this.elements.add(JsonValue.fromArray(value))
        }

        public fun addNull(): Void {
            this.elements.add(JsonValue.fromNull())
        }

        // Generic add method for JsonValue
        public fun addValue(value: JsonValue): Void {
            this.elements.add(value)
        }

        // Get the JsonValue wrapper (contains type information)
        public fun getValue(index: Int): JsonValue {
            return this.elements.get(index)
        }

        // Direct type-safe getters
        public fun getString(index: Int): String {
            var jsonValue = this.elements.get(index)
            return jsonValue.asString()
        }

        public fun getInt(index: Int): Int {
            var jsonValue = this.elements.get(index)
            return jsonValue.asInteger()
        }

        public fun getLong(index: Int): Long {
            var jsonValue = this.elements.get(index)
            return jsonValue.asLong()
        }

        public fun getBool(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.asBool()
        }

        public fun getJsonObject(index: Int): JsonObject {
            var jsonValue = this.elements.get(index)
            return jsonValue.asObject()
        }

        public fun getJsonArray(index: Int): JsonArray {
            var jsonValue = this.elements.get(index)
            return jsonValue.asArray()
        }

        // Type checking methods
        public fun isString(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isString()
        }

        public fun isInteger(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isInteger()
        }

        public fun isDouble(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isDouble()
        }

        public fun isBool(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isBool()
        }

        public fun isNull(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isNull()
        }

        public fun isObject(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isObject()
        }

        public fun isArray(index: Int): Bool {
            var jsonValue = this.elements.get(index)
            return jsonValue.isArray()
        }

        // Get the type of an element
        public fun getType(index: Int): JsonValueType {
            var jsonValue = this.elements.get(index)
            return jsonValue.getType()
        }

        // Set methods
        public fun set(index: Int, value: JsonValue): Void {
            this.elements.set(index, value)
        }

        // Utility methods
        public fun remove(index: Int): JsonValue {
            return this.elements.remove(index)
        }

        public fun size(): Int {
            return this.elements.size()
        }

        public fun isEmpty(): Bool {
            return this.elements.isEmpty()
        }

        public fun indexOf(value: JsonValue): Int {
            return this.elements.indexOf(value)
        }

        public fun contains(value: JsonValue): Bool {
            return this.elements.contains(value)
        }
    }
}