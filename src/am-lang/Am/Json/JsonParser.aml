namespace Am.Json {

    class JsonParser(private var parser: TextParser) {
        import Am.Lang
        import Am.Util.Parsers.Text

        private static var leftBrace: UShort = 123US
        private static var leftBracket: UShort = 91US
        private static var doubleQuote: UShort = 34US
        private static var space: UShort = 32US
        private static var tab: UShort = 9US
        private static var newLine: UShort = 10US
        private static var carriageReturn: UShort = 13US
        // "\\"
        private static var backslash: UShort = 92US

        private fun skipWhitespace() {
            this.parser.skipUntil((c) => return (c != 32US) && (c != 9US) && (c != 10US) && (c != 13US))
        }

        public fun parse(classRef: ClassRef): Any {
            // '{' ascii value is: 123
            // '[' ascii value is: 91
            this.skipWhitespace()
            var c = this.parser.peekChar()
            if (c == JsonParser.leftBrace ) { // '{'
                return this.parseJsonObject(classRef)
            } else if (c == JsonParser.leftBracket) { // '['
                return this.parseJsonArray(classRef)
            } else {
                // Parse single values (string, number, boolValue, null)
                // Return the JsonValue wrapper for type information
                return this.parseValue()
            }
        }

        private fun parseString(): String {
            // check if it starts with a double quote
            var c = this.parser.peekChar()
            if (c != 34US) {
                throw new Exception("Invalid string constant")
            }
            this.parser.skip(1UI) // skip opening quote
            
            var sb: StringBuilder = new StringBuilder()
            var go = true
            while(go) {
                // Parse until " or \
                var str = this.parser.parseUntil((cs) => return (cs == 34US) || cs == 92US)
                sb.add(str)
                
                var c1 = this.parser.peekChar()
                if (c1 == JsonParser.backslash) { // Handle escape sequences
                    this.parser.skip(1UI) // skip backslash
                    var c2 = this.parser.peekChar()
                    if (c2 == 110US) { // 'n'
                        sb.add("\n")
                    } else if (c2 == 116US) { // 't'
                        sb.add("\t")
                    } else if (c2 == 114US) { // 'r'
                        sb.add("\r")
                    } else if (c2 == 98US) { // 'b'
                        sb.add("\b")
                    } else if (c2 == 102US) { // 'f'
                        sb.add("\f")
                    } else if (c2 == 34US) { // '"'
                        sb.add("\"")
                    } else if (c2 == 92US) { // '\'
                        sb.add("\\")
                    } else if (c2 == 47US) { // '/'
                        sb.add("/")
                    } else {
                        // For other escape sequences, just add the character as-is
                        sb.add(c2.toString())
                    }
                    this.parser.skip(1UI) // skip the escaped character
                } else if (c1 == JsonParser.doubleQuote) {
                    this.parser.skip(1UI) // skip closing quote
                    go = false
                } else {
                    throw new Exception("Unexpected character in string")
                }
            }
            return sb.toString()
        }

        private fun parseJsonArray(classRef: ClassRef): JsonArray {
            var jsonArray = new JsonArray()
            this.parser.skip(1UI) // skip '['
            this.skipWhitespace()
            
            // Handle empty array
            var c = this.parser.peekChar()
            if (c == 93US) { // ']'
                this.parser.skip(1UI)
                return jsonArray
            }
            
            while (true) {
                var value = this.parseValue()
                jsonArray.addValue(value)
                this.skipWhitespace()
                
                c = this.parser.peekChar()
                if (c == 44US) { // ','
                    this.parser.skip(1UI)
                    this.skipWhitespace()
                } else if (c == 93US) { // ']'
                    this.parser.skip(1UI)
                    break
                } else {
                    throw new Exception("Expected ',' or ']' in array")
                }
            }
            return jsonArray
        }

        private fun parseValue(): JsonValue {
            this.skipWhitespace()
            var c = this.parser.peekChar()
            
            if (c == 34US) { // '"'
                return JsonValue.fromString(this.parseString())
            } else if (c == 123US) { // '{'
                return JsonValue.fromObject(this.parseJsonObject(null))
            } else if (c == 91US) { // '['
                return JsonValue.fromArray(this.parseJsonArray(null))
            } else if (c == 116US) { // 't' for "true"
                var str = this.parser.peek(4UI)
                if (str == "true") {
                    this.parser.skip(4UI)
                    return JsonValue.fromBool(true)
                } else {
                    throw new Exception("Invalid literal starting with 't'")
                }
            } else if (c == 102US) { // 'f' for "false"
                var str = this.parser.peek(5UI)
                if (str == "false") {
                    this.parser.skip(5UI)
                    return JsonValue.fromBool(false)
                } else {
                    throw new Exception("Invalid literal starting with 'f'")
                }
            } else if (c == 110US) { // 'n' for "null"
                var str = this.parser.peek(4UI)
                if (str == "null") {
                    this.parser.skip(4UI)
                    return JsonValue.fromNull()
                } else {
                    throw new Exception("Invalid literal starting with 'n'")
                }
            } else {
                // number (digits, minus, or plus) - parse all as Long (ignore decimal points)
                var str = this.parser.parseUntil((ch) => return ch == 32US || ch == 9US || ch == 10US || ch == 13US || ch == 44US || ch == 93US || ch == 125US)
                // Remove decimal point and everything after it if present
                var dotIndex = str.indexOf(".")
                if (dotIndex != -1) {
                    str = str.substring(0, dotIndex)
                }
                return JsonValue.fromLong(Long.parseLong(str))
            }
        }

        private fun parseJsonObject(classRef: ClassRef): JsonObject {
            var jsonObject = new JsonObject()
            this.parser.skip(1UI) // skip '{'
            this.skipWhitespace()
            
            // Handle empty object
            var c = this.parser.peekChar()
            if (c == 125US) { // '}'
                this.parser.skip(1UI)
                return jsonObject
            }
            
            while (true) {
                var key = this.parseString()
                this.skipWhitespace()
                
                // Expect ':'
                c = this.parser.peekChar()
                if (c != 58US) { // ':'
                    throw new Exception("Expected ':' after key")
                }
                this.parser.skip(1UI)
                this.skipWhitespace()
                
                var value = this.parseValue()
                jsonObject.putValue(key, value)
                this.skipWhitespace()
                
                c = this.parser.peekChar()
                if (c == 44US) { // ','
                    this.parser.skip(1UI)
                    this.skipWhitespace()
                } else if (c == 125US) { // '}'
                    this.parser.skip(1UI)
                    break
                } else {
                    throw new Exception("Expected ',' or '}' in object")
                }
            }
            return jsonObject
        }
    }
}