namespace Tests {

    class JsonTest {
        import Am.Lang
        import Am.Util.Parsers.Json
        import Am.Util.Parsers.Text

        test parseJsonString() {
            var jsonStr: String = "\"Hello, \\\"World\\\"!\\n\""
            var textParser: TextParser = TextParser(jsonStr)
            var jsonParser: JsonParser = JsonParser(textParser)
            var result: Any = jsonParser.parse(ClassRef(String))
            assert(result is String)
            var parsedStr: String = result as String
            assert(parsedStr == "Hello, \"World\"!\n")
        }
    }
}