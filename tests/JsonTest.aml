namespace Am.Json.Tests {

    class JsonTest {
        import Am.Lang
        import Am.Json
        import Am.Tests
        import Am.Util.Parsers.Text

        test parseJsonValue() {
            // Test that JsonValue can handle string values
            var jsonValue: JsonValue = JsonValue.fromString("Hello World")
            var result: String = jsonValue.asString()
            Assert.assertTrue(result == "Hello World")
        }
    }
}