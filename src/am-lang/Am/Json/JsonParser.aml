namespace Am.Json {

    class JsonParser(private var parser: TextParser) {
        import Am.Lang
        import Am.Util.Parsers.Text

        private static var leftBrace: UShort = 123US
        private static var leftBracket: UShort = 91US
        private static var doubleQuote: UShort = 34US
        private static var space: UShort = 32US
        private static var tab: UShort = 9US
        private static var newLine: UShort = 10US
        private static var carriageReturn: UShort = 13US
        // "\\"
        private static var backslash: UShort = 92US

        private fun skipWhitespace() {
            this.parser.skipUntil((c) => return (c != 32US) && (c != 9US) && (c != 10US) && (c != 13US))
        }

        fun parse(): JsonValue {
            return this.parseValue()
        }


        private fun parseObject(): JsonObject {
            // '{' ascii value is: 123
            // '[' ascii value is: 91
            this.skipWhitespace()
            var c = this.parser.peekChar()
            if (c == JsonParser.leftBrace ) { // '{'            
                return this.parseJsonObject()
            } else {
                throw new Exception("Expected '{' to start JSON object")
            }
        }

        private fun parseArray(): JsonArray {
            this.skipWhitespace()
            var c = this.parser.peekChar()
            if (c == JsonParser.leftBracket) { // '['
                return this.parseJsonArray()
            } else {
                throw new Exception("Expected '[' to start JSON array")
            }
        }

        private fun parseString(): String {
            // check if it starts with a double quote
            var c = this.parser.peekChar()
            if (c != 34US) {
                throw new Exception("Invalid string constant")
            }
            this.parser.skip(1UI) // skip opening quote

            var sb: StringBuilder = new StringBuilder()
            var go = true
            while(go) {
                // Parse until " or \
                var str = this.parser.parseUntil((cs) => return (cs == 34US) || cs == 92US)
                sb.add(str)

                if (!this.parser.hasMore()) {
                    throw new Exception("Unterminated string - reached end of input")
                }

                var c1 = this.parser.peekChar()
                if (c1 == 0US) {
                    throw new Exception("Unterminated string - reached end of input")
                } else if (c1 == JsonParser.backslash) { // Handle escape sequences
                    this.parser.skip(1UI) // skip backslash
                    var c2 = this.parser.peekChar()
                    if (c2 == 0US) {
                        throw new Exception("Unterminated escape sequence")
                    } else if (c2 == 110US) { // 'n'
                        // NOTE: must use addChar(<code>) here — AmLang
                        // doesn't decode `\n`/`\t`/etc. inside string
                        // literals, so `sb.add("\n")` would append the
                        // two-byte sequence `\` + `n` instead of a real
                        // 0x0a byte. Same applies to every escape below.
                        sb.addChar(10US)
                    } else if (c2 == 116US) { // 't'
                        sb.addChar(9US)
                    } else if (c2 == 114US) { // 'r'
                        sb.addChar(13US)
                    } else if (c2 == 98US) { // 'b'
                        sb.addChar(8US)
                    } else if (c2 == 102US) { // 'f'
                        sb.addChar(12US)
                    } else if (c2 == 34US) { // '"'
                        sb.addChar(34US)
                    } else if (c2 == 92US) { // '\'
                        sb.addChar(92US)
                    } else if (c2 == 47US) { // '/'
                        sb.addChar(47US)
                    } else if (c2 == 117US) { // 'u'
                        // \uXXXX — parse 4 hex digits into a codepoint,
                        // then emit UTF-8. For a surrogate high half
                        // (0xD800..0xDBFF), the JSON spec REQUIRES a
                        // second `\uXXXX` in the low-surrogate range
                        // (0xDC00..0xDFFF) — combine them to a
                        // supplementary codepoint (0x10000..0x10FFFF).
                        // A lone / mismatched surrogate emits U+FFFD
                        // (replacement character) so downstream tools
                        // still see valid UTF-8 instead of a bare
                        // half-surrogate that would break `strlen` /
                        // display / write-to-file.
                        this.parser.skip(1UI) // skip 'u'
                        var cp = JsonParser.readHex4(this.parser)
                        if (cp >= 0xD800 && cp <= 0xDBFF) {
                            // High surrogate — must be followed by \uDCxx.
                            var haveLo = false
                            var lo = 0
                            if (this.parser.hasMore() && this.parser.peekChar() == JsonParser.backslash) {
                                this.parser.skip(1UI)
                                if (this.parser.hasMore() && this.parser.peekChar() == 117US) {
                                    this.parser.skip(1UI)
                                    lo = JsonParser.readHex4(this.parser)
                                    if (lo >= 0xDC00 && lo <= 0xDFFF) {
                                        haveLo = true
                                    }
                                }
                            }
                            if (haveLo) {
                                cp = 0x10000 + ((cp - 0xD800) * 0x400) + (lo - 0xDC00)
                            } else {
                                cp = 0xFFFD
                            }
                        } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
                            // Lone low surrogate.
                            cp = 0xFFFD
                        }
                        JsonParser.appendUtf8(sb, cp)
                        // We already consumed the escape body via
                        // readHex4; skip the `continue` fall-through.
                        continue
                    } else {
                        // For other escape sequences, just add the character as-is
                        sb.addChar(c2)
                    }
                    this.parser.skip(1UI) // skip the escaped character
                } else if (c1 == JsonParser.doubleQuote) {
                    this.parser.skip(1UI) // skip closing quote
                    go = false
                } else {
                    throw new Exception("Unexpected character in string: " + c1.toString())
                }
            }
            return sb.toString()
        }

        private fun parseJsonArray(): JsonArray {
            var jsonArray = new JsonArray()
            this.parser.skip(1UI) // skip '['
            this.skipWhitespace()
            
            // Handle empty array
            var c = this.parser.peekChar()
            if (c == 93US) { // ']'
                this.parser.skip(1UI)
                return jsonArray
            }
            
            while (true) {
                var value = this.parseValue()
                jsonArray.addValue(value)
                this.skipWhitespace()
                
                c = this.parser.peekChar()
                if (c == 44US) { // ','
                    this.parser.skip(1UI)
                    this.skipWhitespace()
                } else if (c == 93US) { // ']'
                    this.parser.skip(1UI)
                    break
                } else {
                    throw new Exception("Expected ',' or ']' in array")
                }
            }
            return jsonArray
        }

        private fun parseValue(): JsonValue {
            this.skipWhitespace()
            var c = this.parser.peekChar()
            
            if (c == 34US) { // '"'
                return JsonValue.fromString(this.parseString())
            } else if (c == 123US) { // '{'
                return JsonValue.fromObject(this.parseJsonObject())
            } else if (c == 91US) { // '['
                return JsonValue.fromArray(this.parseJsonArray())
            } else {
                // Parse as raw value (number, boolean, null)
                // Stop at whitespace, delimiters, but NOT at decimal points or negative signs
                var str = this.parser.parseUntil((ch) => return ch == 32US || ch == 9US || ch == 10US || ch == 13US || ch == 44US || ch == 93US || ch == 125US)
                
                // Check for specific literal values
                if (str == "true" || str == "false") {
                    return JsonValue.fromBool(str == "true")
                } else if (str == "null") {
                    return JsonValue.fromNull()
                } else {
                    // Treat as number (stored as string, parsed on demand)
                    return JsonValue.fromNumber(str)
                }
            }
        }

        private fun parseJsonObject(): JsonObject {
            var jsonObject = new JsonObject()
            this.parser.skip(1UI) // skip '{'
            this.skipWhitespace()
            
            // Handle empty object
            var c = this.parser.peekChar()
            if (c == 125US) { // '}'
                this.parser.skip(1UI)
                return jsonObject
            }
            
            while (true) {
                var key = this.parseString()
                this.skipWhitespace()

                // Expect ':'
                c = this.parser.peekChar()
                if (c != 58US) { // ':'
                    throw new Exception("Expected ':' after key")
                }
                this.parser.skip(1UI)
                this.skipWhitespace()

                var value = this.parseValue()

                jsonObject.putValue(key, value)
                this.skipWhitespace()
                
                c = this.parser.peekChar()
                if (c == 44US) { // ','
                    this.parser.skip(1UI)
                    this.skipWhitespace()
                } else if (c == 125US) { // '}'
                    this.parser.skip(1UI)
                    break
                } else {
                    throw new Exception("Expected ',' or '}' in object")
                }
            }
            return jsonObject
        }

        // Parse exactly 4 hex digits from the current parser position,
        // advancing past them. Returns the integer value. Throws if any
        // of the 4 characters isn't a valid hex digit — that's a
        // malformed JSON escape, same class as an unterminated string.
        private static fun readHex4(parser: TextParser): Int {
            var v = 0
            var i = 0
            while (i < 4) {
                if (!parser.hasMore()) {
                    throw new Exception("Truncated \\uXXXX escape")
                }
                var c = parser.peekChar()
                var d = 0
                if (c >= 48US && c <= 57US) {
                    d = (c - 48US) as Int
                } else if (c >= 65US && c <= 70US) {
                    d = ((c - 65US) as Int) + 10
                } else if (c >= 97US && c <= 102US) {
                    d = ((c - 97US) as Int) + 10
                } else {
                    throw new Exception("Invalid hex digit in \\uXXXX escape")
                }
                v = (v * 16) + d
                parser.skip(1UI)
                i = i + 1
            }
            return v
        }

        // Emit UTF-8 for a Unicode codepoint (0..0x10FFFF) as one to
        // four bytes into the StringBuilder. StringBuilder.addChar
        // stores the low 8 bits verbatim (see its TODO note), so we can
        // stream the bytes through it without triggering the
        // truncation-above-0xFF behaviour — we've already broken the
        // codepoint into ≤0xFF bytes ourselves.
        //
        // Byte-count / prefix table:
        //   1 byte  0xxxxxxx                          U+0000..U+007F
        //   2 bytes 110xxxxx 10xxxxxx                 U+0080..U+07FF
        //   3 bytes 1110xxxx 10xxxxxx 10xxxxxx        U+0800..U+FFFF
        //   4 bytes 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx  U+10000..U+10FFFF
        private static fun appendUtf8(sb: StringBuilder, cp: Int) {
            if (cp < 0x80) {
                sb.addChar(cp as UShort)
            } else if (cp < 0x800) {
                sb.addChar((0xC0 | ((cp >> 6) & 0x1F)) as UShort)
                sb.addChar((0x80 | (cp & 0x3F)) as UShort)
            } else if (cp < 0x10000) {
                sb.addChar((0xE0 | ((cp >> 12) & 0x0F)) as UShort)
                sb.addChar((0x80 | ((cp >> 6) & 0x3F)) as UShort)
                sb.addChar((0x80 | (cp & 0x3F)) as UShort)
            } else {
                sb.addChar((0xF0 | ((cp >> 18) & 0x07)) as UShort)
                sb.addChar((0x80 | ((cp >> 12) & 0x3F)) as UShort)
                sb.addChar((0x80 | ((cp >> 6) & 0x3F)) as UShort)
                sb.addChar((0x80 | (cp & 0x3F)) as UShort)
            }
        }
    }
}