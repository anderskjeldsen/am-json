namespace Am.Json.Tests {
    class JsonSimpleParseTest {
        import Am.Lang
        import Am.Json
        import Am.Tests
        import Am.Util.Parsers.Text

        test debugParseDirectString() {
            // Construct JSON string with proper quote characters
            var quoteBytes: UByte[] = [34UB]
            var quote = String.fromBytes(quoteBytes, "UTF-8")
            var jsonStr = "{" + quote + "name" + quote + ":" + quote + "John" + quote + "}"
            
            "About to parse JSON".println()
            jsonStr.println()
            ("String length: " + jsonStr.getLength().toString()).println()
            
            // Debug each character
            "String character by character:".println()
            for(i = 0 to jsonStr.getLength()) {
                var char = jsonStr.characterAt(i.toUInt())
                ("Index " + i.toString() + ": character code " + char.toString()).println()
            }
            
            try {
                "TextParser created".println()
                var parser = new TextParser(jsonStr)
                "JsonParser created, attempting to parse...".println()
                var jsonParser = new JsonParser(parser)
                var jsonRoot = jsonParser.parse()
                var result = jsonRoot.asObject()
                "Parse succeeded!".println()
            } catch(e: Exception) {
                "Parse failed with exception:".println()
                e.message.println()
                throw e
            }
        }
    }
}