namespace Tests {

    class JsonValueTest {
        import Am.Lang
        import Am.Json
        import Am.Util.Parsers.Text

        test testJsonObjectWithTypes() {
            // Create a JsonObject with typed values
            var person = new JsonObject()
            person.put("name", "John Doe")
            person.put("age", 30)
            person.put("salary", 75000.50)
            person.put("active", true)
            person.putNull("manager")
            
            // Test type checking
            assert(person.isString("name"))
            assert(person.isInteger("age"))
            assert(person.isDouble("salary"))
            assert(person.isBoolean("active"))
            assert(person.isNull("manager"))
            
            // Test type-safe getters
            assert(person.getString("name") == "John Doe")
            assert(person.getInt("age") == 30)
            assert(person.getDouble("salary") == 75000.50)
            assert(person.getBoolean("active") == true)
            
            // Test getting JsonValue with type information
            var nameValue = person.getValue("name")
            assert(nameValue.getType() == JsonValueType.string)
            assert(nameValue.asString() == "John Doe")
        }

        test testJsonArrayWithTypes() {
            var numbers = new JsonArray()
            numbers.add(1)
            numbers.add(2.5)
            numbers.add("three")
            numbers.add(true)
            numbers.addNull()
            
            // Test type checking
            assert(numbers.isInteger(0))
            assert(numbers.isDouble(1))
            assert(numbers.isString(2))
            assert(numbers.isBoolean(3))
            assert(numbers.isNull(4))
            
            // Test type-safe getters
            assert(numbers.getInt(0) == 1)
            assert(numbers.getDouble(1) == 2.5)
            assert(numbers.getString(2) == "three")
            assert(numbers.getBoolean(3) == true)
            
            // Test getting JsonValue with type information
            var firstValue = numbers.getValue(0)
            assert(firstValue.getType() == JsonValueType.integer)
            assert(firstValue.asInteger() == 1)
        }

        test testNestedJsonStructure() {
            var company = new JsonObject()
            company.put("name", "Tech Corp")
            
            var employees = new JsonArray()
            
            var employee1 = new JsonObject()
            employee1.put("name", "Alice")
            employee1.put("id", 1)
            employees.add(employee1)
            
            var employee2 = new JsonObject()
            employee2.put("name", "Bob")
            employee2.put("id", 2)
            employees.add(employee2)
            
            company.put("employees", employees)
            
            // Test nested structure
            assert(company.isObject("employees"))
            var employeeArray = company.getJsonArray("employees")
            assert(employeeArray.size() == 2)
            
            var firstEmployee = employeeArray.getJsonObject(0)
            assert(firstEmployee.getString("name") == "Alice")
            assert(firstEmployee.getInt("id") == 1)
        }
    }
}