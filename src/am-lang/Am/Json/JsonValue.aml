namespace Am.Json {

    enum JsonValueType {
        stringType = 1
        numberType = 2
        boolType = 3
        nullType = 4
        objectType = 5
        arrayType = 6
    }

    class JsonValue(private var value: Any, private var type: JsonValueType) {
        import Am.Lang

        public fun getValue(): Any {
            return this.value
        }

        public fun getType(): JsonValueType {
            return this.type
        }

        public fun isString(): Bool {
            return this.type == JsonValueType.stringType
        }

        public fun isNumber(): Bool {
            return this.type == JsonValueType.numberType
        }

        public fun isBool(): Bool {
            return this.type == JsonValueType.boolType
        }

        public fun isNull(): Bool {
            return this.type == JsonValueType.nullType
        }

        public fun isObject(): Bool {
            return this.type == JsonValueType.objectType
        }

        public fun isArray(): Bool {
            return this.type == JsonValueType.arrayType
        }

        public fun asString(): String {
            if (this.type == JsonValueType.stringType) {
                return this.value as String
            } else {
                throw new Exception("JsonValue is not a string")
            }
        }

        public fun asInteger(): Int {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Int.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asLong(): Long {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Long.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asByte(): Byte {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Byte.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asShort(): Short {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Short.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asUInteger(): UInt {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return UInt.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asULong(): ULong {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return ULong.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asUByte(): UByte {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return UByte.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asUShort(): UShort {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return UShort.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asDouble(): Double {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Double.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asFloat(): Float {
            if (this.type == JsonValueType.numberType) {
                var stringValue = this.value as String
                return Float.parse(stringValue)
            } else {
                throw new Exception("JsonValue is not a number")
            }
        }

        public fun asBool(): Bool {
            if (this.type == JsonValueType.boolType) {
                return this.value as Bool
            } else {
                throw new Exception("JsonValue is not a boolean")
            }
        }

        public fun asObject(): JsonObject {
            if (this.type == JsonValueType.objectType) {
                return this.value as JsonObject
            } else {
                throw new Exception("JsonValue is not an object")
            }
        }

        public fun asArray(): JsonArray {
            if (this.type == JsonValueType.arrayType) {
                return this.value as JsonArray
            } else {
                throw new Exception("JsonValue is not an array")
            }
        }

        static fun fromString(value: String): JsonValue {
            return new JsonValue(value, JsonValueType.stringType)
        }

        static fun fromNumber(value: String): JsonValue {
            return new JsonValue(value, JsonValueType.numberType)
        }

        static fun fromInteger(value: Int): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromLong(value: Long): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromByte(value: Byte): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromShort(value: Short): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromUInteger(value: UInt): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromULong(value: ULong): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromUByte(value: UByte): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromUShort(value: UShort): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromDouble(value: Double): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromFloat(value: Float): JsonValue {
            return new JsonValue(value.toString(), JsonValueType.numberType)
        }

        static fun fromBool(value: Bool): JsonValue {
            return new JsonValue(value, JsonValueType.boolType)
        }

        static fun fromObject(value: JsonObject): JsonValue {
            return new JsonValue(value, JsonValueType.objectType)
        }

        static fun fromArray(value: JsonArray): JsonValue {
            return new JsonValue(value, JsonValueType.arrayType)
        }

        static fun fromNull(): JsonValue {
            var nullValue: Any = null
            return new JsonValue(nullValue, JsonValueType.nullType)
        }

        public fun toJsonString(): String {
            if (this.type == JsonValueType.stringType) {
                return "\"" + JsonValue.escapeJsonString(this.asString()) + "\""
            } else if (this.type == JsonValueType.numberType) {
                return this.value as String
            } else if (this.type == JsonValueType.boolType) {
                if (this.asBool()) {
                    return "true"
                } else {
                    return "false"
                }
            } else if (this.type == JsonValueType.nullType) {
                return "null"
            } else if (this.type == JsonValueType.objectType) {
                return this.asObject().toJsonString()
            } else if (this.type == JsonValueType.arrayType) {
                return this.asArray().toJsonString()
            } else {
                return "null"
            }
        }

        override fun toString(): String {
            if (this.type == JsonValueType.stringType) {
                return either(this.asString(), "[]")
            } else if (this.type == JsonValueType.numberType) {
                return either(this.value as String, "0")
            } else if (this.type == JsonValueType.boolType) {
                if (either(this.asBool(), false)) {
                    return "true"
                } else {
                    return "false"
                }
            } else if (this.type == JsonValueType.nullType) {
                return "null"
            } else if (this.type == JsonValueType.objectType) {
                return either(this.asObject().toString(), "{}")
            } else if (this.type == JsonValueType.arrayType) {
                return either(this.asArray().toString(), "[]")
            } else {
                return "unknown"
            }
        }

        // JSON-escape a string for embedding inside a "..." literal.
        // Mirrors the decoding rules in JsonParser.parseString:
        //
        //   \"  \\  \/  \b  \f  \n  \r  \t  and  \u00XX  for any
        //   remaining control byte (0x00..0x1F).
        //
        // HIGH BYTES (>= 0x80) are where the care is needed, because an
        // AmLang String is a byte array with no declared encoding and two
        // very different kinds of content arrive in one:
        //
        //   * VALID UTF-8 -- anything that came off the network or out of
        //     a UTF-8 editor buffer. These bytes are passed through
        //     VERBATIM. Strict JSON permits raw UTF-8 in a string, every
        //     parser decodes it, and the bytes survive a save/load round
        //     trip unchanged.
        //
        //   * LONE HIGH BYTES -- Latin-1 / Win-1252 text from an AmigaOS
        //     source file, where 'å' is the single byte 0xE5. That is not
        //     valid UTF-8, and emitting it raw produces a document strict
        //     parsers reject outright (OpenAI answers 400 "error parsing
        //     the body"). Those are escaped as \u00XX, whose codepoint
        //     matches Latin-1 exactly.
        //
        // Escaping the UTF-8 case as well -- which this used to do -- is
        // what made a Norwegian 'o-slash' in a chat transcript grow into
        // ~100 characters: each of its two bytes became its own \uXXXX
        // codepoint, the parser re-encoded each of those as multi-byte
        // UTF-8, and the next save escaped every one of THOSE bytes
        // again. Round trips multiplied the length instead of preserving
        // it. Byte-exactness for valid UTF-8 is what stops that, and it
        // also means the remote API receives the character the user
        // actually typed rather than mojibake.
        //
        // Originally added because round-tripping a multi-turn chat
        // through ChatGptClient.complete() failed: the assistant's
        // first reply landed in the message history with embedded
        // newlines, then the second request body emitted those LF
        // bytes inside string literals and OpenAI rejected the
        // payload with "We could not parse the JSON body of your
        // request."
        static fun escapeJsonString(s: String): String {
            if (s == null || s.length() == 0) {
                return ""
            }
            var sb = new StringBuilder()
            var i = 0UI
            var len = s.length().toUInt()
            while (i < len) {
                var c = s.characterAt(i)
                if (c == 34US) {
                    sb.add("\\\"")
                } else if (c == 92US) {
                    sb.add("\\\\")
                } else if (c == 8US) {
                    sb.add("\\b")
                } else if (c == 9US) {
                    sb.add("\\t")
                } else if (c == 10US) {
                    sb.add("\\n")
                } else if (c == 12US) {
                    sb.add("\\f")
                } else if (c == 13US) {
                    sb.add("\\r")
                } else if (c < 32US) {
                    // Remaining control bytes (NUL, ASCII control
                    // chars without dedicated escape sequences) →
                    // \u00XX hex form so the parser doesn't have
                    // to deal with them as raw bytes.
                    sb.add("\\u00")
                    JsonValue.appendHexNibble(sb, (c.toInt() / 16) % 16)
                    JsonValue.appendHexNibble(sb, c.toInt() % 16)
                } else if (c >= 128US) {
                    // Part of a well-formed UTF-8 sequence: copy the
                    // whole sequence through untouched. Checked as a
                    // sequence rather than a byte at a time because a
                    // continuation byte is only meaningful after its
                    // lead byte.
                    var seqLen = JsonValue.utf8SequenceLength(s, i, len)
                    if (seqLen > 0UI) {
                        var k = 0UI
                        while (k < seqLen) {
                            sb.addChar(s.characterAt(i + k))
                            k++
                        }
                        // -1 because the loop's own i++ adds the last one.
                        i = i + seqLen - 1UI
                    } else {
                        // Not valid UTF-8 -- a lone high byte, almost
                        // always Latin-1 from an Amiga text file. Emit it
                        // as \u00XX: the codepoint matches Latin-1, and
                        // the document stays parseable by a strict reader.
                        var v = c.toInt() % 256
                        sb.add("\\u00")
                        JsonValue.appendHexNibble(sb, (v / 16) % 16)
                        JsonValue.appendHexNibble(sb, v % 16)
                    }
                } else {
                    sb.addChar(c)
                }
                i++
            }
            return sb.toString()
        }

        // Length of the well-formed UTF-8 sequence starting at `at`, or 0
        // when the bytes there are not one. Rejects the malformed shapes a
        // strict decoder rejects -- overlong encodings, surrogates encoded
        // as three bytes, codepoints past U+10FFFF, truncated sequences,
        // and missing continuation bytes -- because passing any of those
        // through raw produces a document a strict JSON reader refuses,
        // which is the failure this whole branch exists to avoid.
        static fun utf8SequenceLength(s: String, at: UInt, len: UInt): UInt {
            var b0 = s.characterAt(at).toInt()
            var need = 0
            var cp = 0
            if (b0 >= 0xC2 && b0 <= 0xDF) {
                need = 1
                cp = b0 - 0xC0
            } else if (b0 >= 0xE0 && b0 <= 0xEF) {
                need = 2
                cp = b0 - 0xE0
            } else if (b0 >= 0xF0 && b0 <= 0xF4) {
                need = 3
                cp = b0 - 0xF0
            } else {
                // 0x80..0xC1 -- a continuation byte with no lead, or an
                // overlong two-byte form. 0xF5..0xFF -- past U+10FFFF.
                return 0UI
            }
            if (at + need.toUInt() >= len) {
                return 0UI
            }
            var k = 1
            while (k <= need) {
                var bn = s.characterAt(at + k.toUInt()).toInt()
                if (bn < 0x80 || bn > 0xBF) {
                    return 0UI
                }
                cp = (cp * 64) + (bn - 0x80)
                k = k + 1
            }
            // Overlong forms and the surrogate range are ill-formed even
            // though their bytes look structurally fine.
            if (need == 2 && cp < 0x800) {
                return 0UI
            }
            if (need == 3 && cp < 0x10000) {
                return 0UI
            }
            if (cp >= 0xD800 && cp <= 0xDFFF) {
                return 0UI
            }
            if (cp > 0x10FFFF) {
                return 0UI
            }
            return (need + 1).toUInt()
        }

        // Append one hex digit (0..15) directly into `sb` as its
        // character code: '0'..'9' for 0..9, 'a'..'f' for 10..15.
        // Lowercase to match the canonical JSON output of every
        // upstream tool we'd diff a payload against.
        private static fun appendHexNibble(sb: StringBuilder, n: Int) {
            if (n < 10) {
                sb.addChar((48 + n).toUShort())
            } else {
                sb.addChar((87 + n).toUShort())
            }
        }
    }
}
