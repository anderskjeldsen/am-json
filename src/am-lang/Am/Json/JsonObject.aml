namespace Am.Json {

    class JsonObject {
        import Am.Lang
        import Am.Collections

        private var properties: HashMap<String, JsonValue> = new HashMap<String, JsonValue>()

        // The keys in the order they were put, because a HashMap's own order
        // is its hash order: `{"name":...,"version":...}` parsed and printed
        // again came back with the keys shuffled, which makes a serialized
        // document impossible to compare with the one it came from, and an
        // HTTP API's response body different every time its keys change.
        // JSON says an object is unordered; nothing says a library has to
        // make it look that way.
        private var order: List<String> = new List<String>()

        // Put methods for different types
        public fun putString(key: String, value: String) {
            this.putValue(key, JsonValue.fromString(value))
        }

        public fun putInt(key: String, value: Int) {
            this.putValue(key, JsonValue.fromInteger(value))
        }

        public fun putLong(key: String, value: Long) {
            this.putValue(key, JsonValue.fromLong(value))
        }

        public fun putByte(key: String, value: Byte) {
            this.putValue(key, JsonValue.fromByte(value))
        }

        public fun putShort(key: String, value: Short) {
            this.putValue(key, JsonValue.fromShort(value))
        }

        public fun putUInt(key: String, value: UInt) {
            this.putValue(key, JsonValue.fromUInteger(value))
        }

        public fun putULong(key: String, value: ULong) {
            this.putValue(key, JsonValue.fromULong(value))
        }

        public fun putUByte(key: String, value: UByte) {
            this.putValue(key, JsonValue.fromUByte(value))
        }

        public fun putUShort(key: String, value: UShort) {
            this.putValue(key, JsonValue.fromUShort(value))
        }

        public fun putDouble(key: String, value: Double) {
            this.putValue(key, JsonValue.fromDouble(value))
        }

        public fun putFloat(key: String, value: Float) {
            this.putValue(key, JsonValue.fromFloat(value))
        }

        public fun putNumber(key: String, value: String) {
            this.putValue(key, JsonValue.fromNumber(value))
        }

        public fun putBool(key: String, value: Bool) {
            this.putValue(key, JsonValue.fromBool(value))
        }

        public fun putObject(key: String, value: JsonObject) {
            this.putValue(key, JsonValue.fromObject(value))
        }

        public fun putArray(key: String, value: JsonArray) {
            this.putValue(key, JsonValue.fromArray(value))
        }

        public fun putNull(key: String) {
            this.putValue(key, JsonValue.fromNull())
        }

        // Generic put method for JsonValue. Every typed putter above goes
        // through here, so recording the order in one place covers them all.
        public fun putValue(key: String, value: JsonValue) {
            if (!this.properties.containsKey(key)) { this.order.add(key) }
            this.properties.set(key, value)
        }

        // Get the JsonValue wrapper (contains type information)
        public fun getValue(key: String): JsonValue {
            return this.properties.get(key)
        }

        // Direct type-safe getters
        public fun getString(key: String): String {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asString()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getInt(key: String): Int {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asInteger()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getFloat(key: String): Float {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asFloat()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getLong(key: String): Long {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asLong()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getByte(key: String): Byte {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asByte()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getShort(key: String): Short {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asShort()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getUInt(key: String): UInt {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asUInteger()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getULong(key: String): ULong {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asULong()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getUByte(key: String): UByte {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asUByte()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getUShort(key: String): UShort {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asUShort()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getBool(key: String): Bool {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asBool()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getJsonObject(key: String): JsonObject {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asObject()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getJsonArray(key: String): JsonArray {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asArray()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        // Get nested objects and arrays
        public fun getObject(key: String): JsonObject {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asObject()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        public fun getArray(key: String): JsonArray {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.asArray()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        // Type checking methods
        public fun isString(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isString()
        }

        public fun isNumber(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isNumber()
        }

        public fun isBool(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isBool()
        }

        public fun isNull(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isNull()
        }

        public fun isObject(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isObject()
        }

        public fun isArray(key: String): Bool {
            var jsonValue = this.properties.get(key)
            return jsonValue != null && jsonValue.isArray()
        }

        // Get the type of a property
        public fun getType(key: String): JsonValueType {
            var jsonValue = this.properties.get(key)
            if (jsonValue != null) {
                return jsonValue.getType()
            }
            throw new Exception("Key '" + key + "' not found")
        }

        // Utility methods
        public fun has(key: String): Bool {
            return this.properties.containsKey(key)
        }

        public fun remove(key: String): Bool {
            var removed = this.properties.remove(key)
            if (removed) {
                var kept = new List<String>()
                var i = 0
                while (i < this.order.getSize()) {
                    if (!this.order.get(i).equals(key)) { kept.add(this.order.get(i)) }
                    i = i + 1
                }
                this.order = kept
            }
            return removed
        }

        /** The keys in insertion order — a copy, so a caller cannot reorder it. */
        public fun keys(): List<String> {
            var out = new List<String>()
            var i = 0
            while (i < this.order.getSize()) {
                out.add(this.order.get(i))
                i = i + 1
            }
            return out
        }

        public fun size(): Int {
            return this.properties.getSize()
        }

        public fun isEmpty(): Bool {
            return this.properties.isEmpty()
        }

        public fun toJsonString(): String {
            var result = "{"
            var keys = this.keys()
            var first = true
            
            var i = 0
            while (i < keys.getSize()) {
                var key = keys.get(i)
                var value = this.getValue(key)
                
                if (!first) {
                    result = result + ","
                }
                
                // Escape the key the same way as string values —
                // a `"` or control char in a key would otherwise
                // emit malformed JSON. Most callers pass safe ASCII
                // keys, but the helper is cheap when the input is
                // already escape-free.
                result = result + "\"" + JsonValue.escapeJsonString(key) + "\":" + value.toJsonString()
                first = false
                i = i + 1
            }
            
            result = result + "}"
            return result
        }
    }
}