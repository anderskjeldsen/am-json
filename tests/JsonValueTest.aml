namespace Am.Json.Tests {

    class JsonValueTest {
        import Am.Lang
        import Am.Json
        import Am.Tests

        test testJsonValue() {
            // Test JsonValue creation and type detection
            var stringValue: JsonValue = JsonValue.fromString("Hello World")
            Assert.assertTrue(stringValue.getType() == JsonValueType.stringType)
            Assert.assertTrue(stringValue.asString() == "Hello World")
        }

        test testJsonObjectWithStrings() {
            // Create a JsonObject with string values only
            var person: JsonObject = new JsonObject()
            person.putString("name", "John Doe")
            person.putString("age", "30")
            person.putString("active", "true")
            
            // Test getting string values
            Assert.assertTrue(person.getString("name") == "John Doe")
            Assert.assertTrue(person.getString("age") == "30")
            Assert.assertTrue(person.getString("active") == "true")
            
            // Test size
            Assert.assertTrue(person.size() == 3)
        }

        test testJsonArrayWithStrings() {
            var items: JsonArray = new JsonArray()
            items.addString("first")
            items.addString("second")
            items.addString("third")
            
            // Test getting string values
            Assert.assertTrue(items.getString(0) == "first")
            Assert.assertTrue(items.getString(1) == "second")
            Assert.assertTrue(items.getString(2) == "third")
            
            // Test size
            Assert.assertTrue(items.size() == 3)
        }

        test testJsonValueTypeChecking() {
            // Test type checking methods
            var stringValue = JsonValue.fromString("hello")
            Assert.assertTrue(stringValue.isString())
            Assert.assertFalse(stringValue.isInteger())
            Assert.assertFalse(stringValue.isBool())
            Assert.assertFalse(stringValue.isNull())
            Assert.assertFalse(stringValue.isObject())
            Assert.assertFalse(stringValue.isArray())

            // Test null value
            var nullValue = JsonValue.fromNull()
            Assert.assertTrue(nullValue.isNull())
            Assert.assertFalse(nullValue.isString())
            Assert.assertFalse(nullValue.isInteger())
            Assert.assertFalse(nullValue.isBool())
            Assert.assertFalse(nullValue.isObject())
            Assert.assertFalse(nullValue.isArray())
        }
    }
}